---
import ServicePage from '@/layouts/ServicePage.astro';
import { services } from '@/data/services';

const service = services['treninu-plani'];
const map = service.programMap!;
const noise =
  "url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E\")";
---
<ServicePage service={service}>
  <!-- Interactive program map -->
  <section id="karte" class="relative z-10 border-b border-zinc-200 bg-white px-6 py-16 transition-colors duration-300 md:py-20 dark:border-white/5 dark:bg-zinc-900/30">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 border-l-4 border-brand pl-6">
        <h2 class="text-4xl font-semibold uppercase tracking-tight text-zinc-900 md:text-5xl dark:text-white">{map.heading}</h2>
        <p class="mt-2 font-mono text-xs uppercase tracking-widest text-zinc-500">{map.subheading}</p>
      </div>
      <!-- Dark interactive panel (self-contained; rendered by src/scripts/program-map.js) -->
      <div class="relative overflow-hidden rounded-xs border border-zinc-800" style="background:#09090b">
        <div style={`position:absolute;inset:0;pointer-events:none;z-index:0;background-image:${noise};mix-blend-mode:overlay;opacity:.35`}></div>
        <div id="ak-program-map" class="font-sans" style="position:relative;z-index:1;max-width:960px;margin:0 auto;padding:40px 16px 48px;color:#d4d4d8">
          <noscript><p style="color:#a1a1aa;text-align:center;padding:24px">Programmu karte prasa JavaScript. Visi plāni: pamati, periodizācija, hipertrofija, spēks, fokusa muskuļgrupas, sporta specializācija un sacensību programmas.</p></noscript>
        </div>
      </div>
    </div>
  </section>
</ServicePage>

<script>
  import '@/scripts/program-map.js';
</script>
