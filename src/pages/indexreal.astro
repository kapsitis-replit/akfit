---
/**
 * The real landing page. Lives at /indexreal.html while / shows the
 * coming-soon page; swap at launch (plans/astro-migration.md, Phase 6 step 4).
 */
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/home/Hero.astro';
import TrustBar from '@/components/home/TrustBar.astro';
import Coaches from '@/components/home/Coaches.astro';
import WhoFor from '@/components/home/WhoFor.astro';
import Pricing from '@/components/home/Pricing.astro';
import Results from '@/components/home/Results.astro';
import Process from '@/components/home/Process.astro';
import Faq from '@/components/home/Faq.astro';
import FinalCta from '@/components/home/FinalCta.astro';
---
<Base
  title="AK FITNESS | Individuālie Treniņu Plāni"
  description="AK Fitness — individuāli treniņu un uztura plāni, zinātnē balstīta metodika un sertificēti treneri. Online coaching, klātienes treniņi un konsultācijas Rīgā."
  path="/"
  ogTitle="AK Fitness | Individuālie Treniņu Plāni"
  ogDescription="Zinātnē balstīta treniņu un uztura metodika. Sertificēti treneri, individuāla pieeja, garantēts rezultāts."
>
  <Nav onHome />
  <Hero />
  <TrustBar />
  <Coaches />
  <WhoFor />
  <Pricing />
  <Results />
  <Process />
  <Faq />
  <FinalCta />
  <Footer variant="home" />
</Base>
