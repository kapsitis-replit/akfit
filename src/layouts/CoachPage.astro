---
/** Coach profile page from a `coaches.ts` entry. */
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import ColorHoverImage from '@/components/ColorHoverImage.astro';
import Base from './Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import BackLink from '@/components/sections/BackLink.astro';
import { HOME } from '@/data/site';
import type { Coach } from '@/data/types';

interface Props {
  coach: Coach;
}
const { coach } = Astro.props;
const { meta } = coach;

const sectionHeading = 'text-3xl font-semibold uppercase tracking-tight text-zinc-900 md:text-4xl dark:text-white';
// An odd number of certifications: the last one spans both columns.
const certSpan = (i: number) => coach.certifications.items.length % 2 === 1 && i === coach.certifications.items.length - 1;
---
<Base
  title={meta.title}
  description={meta.description}
  path={coach.path}
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
>
  <Nav active="about" cta={{ label: coach.navCtaLabel, href: `${HOME}#pricing` }} />

  <!-- Hero -->
  <header class="relative z-10 overflow-hidden border-b border-zinc-200 px-6 pt-32 pb-16 transition-colors duration-300 md:pt-40 md:pb-24 dark:border-white/5">
    <div class="mx-auto max-w-7xl">
      <BackLink href={`${HOME}#about`} label="Visi Treneri" />
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="relative lg:col-span-5">
          <div class="absolute -top-4 -left-4 h-24 w-24 border-t-2 border-l-2 border-brand"></div>
          <div class="absolute -right-4 -bottom-4 h-24 w-24 border-r-2 border-b-2 border-brand"></div>
          <Image
            src={coach.image.src}
            alt={coach.image.alt}
            inferSize
            widths={[400, 640, 800]}
            sizes="(min-width: 1024px) 500px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] w-full object-cover object-top grayscale"
          />
        </div>
        <div class="space-y-6 lg:col-span-7">
          <p class="font-mono text-xs uppercase tracking-widest text-brand">{coach.role}</p>
          <h1 class="animate-intro text-5xl leading-none font-semibold uppercase tracking-tight text-zinc-900 md:text-7xl dark:text-white md:leading-none">{coach.name}</h1>
          <p class="max-w-xl border-l-2 border-brand pl-6 text-lg leading-relaxed font-normal text-zinc-800 md:text-xl dark:font-light dark:text-zinc-400 md:leading-[1.75rem]">{coach.quote}</p>
          <div class="flex flex-wrap gap-6 pt-2">
            {coach.stats.map((s) => (
              <div>
                <p class="text-3xl font-semibold text-zinc-900 dark:text-white">{s.value}</p>
                <p class="font-mono text-xs uppercase tracking-widest text-zinc-500">{s.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Philosophy -->
  <section class="relative z-10 border-b border-zinc-200 bg-white px-6 py-20 transition-colors duration-300 dark:border-white/5 dark:bg-zinc-900/30">
    <div class="mx-auto max-w-3xl">
      <div class="mb-8 border-l-4 border-brand pl-6" data-reveal>
        <h2 class={sectionHeading}>{coach.philosophy.heading}</h2>
      </div>
      <div class="space-y-5 leading-relaxed text-zinc-600 dark:text-zinc-400">
        {coach.philosophy.paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <!-- Life path timeline -->
  <section class="relative z-10 border-b border-zinc-200 px-6 py-20 transition-colors duration-300 dark:border-white/5">
    <div class="mx-auto max-w-3xl">
      <div class="mb-12 border-l-4 border-brand pl-6" data-reveal>
        <h2 class={sectionHeading}>{coach.timeline.heading}</h2>
        <p class="mt-2 font-mono text-xs uppercase tracking-widest text-zinc-500">{coach.timeline.subheading}</p>
      </div>
      <div class="relative ml-3 space-y-10 border-l-2 border-zinc-200 dark:border-zinc-800">
        {coach.timeline.items.map((item) => (
          <div class="relative pl-8">
            <span class="absolute top-1 -left-[9px] h-4 w-4 rounded-full border-4 border-zinc-50 bg-brand dark:border-zinc-950"></span>
            <p class="mb-1 font-mono text-xs uppercase tracking-widest text-brand">{item.when}</p>
            <h3 class="mb-1 text-lg font-semibold uppercase tracking-tight text-zinc-900 dark:text-white">{item.title}</h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="relative z-10 border-b border-zinc-200 bg-zinc-100 px-6 py-20 transition-colors duration-300 dark:border-white/5 dark:bg-zinc-900">
    <div class="mx-auto max-w-4xl">
      <div class="mb-10 border-l-4 border-brand pl-6" data-reveal>
        <h2 class={sectionHeading}>{coach.certifications.heading}</h2>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2" data-reveal-children>
        {coach.certifications.items.map((cert, i) => (
          <div class:list={['flex items-center gap-3 border border-zinc-200 bg-white p-4 dark:border-white/5 dark:bg-zinc-950/50', certSpan(i) && 'sm:col-span-2']}>
            <Icon name="solar:diploma-verified-linear" width={24} height={24} class="shrink-0 text-brand" aria-hidden="true" />
            <span class="text-sm font-semibold uppercase tracking-wide text-zinc-900 dark:text-white">{cert}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="relative z-10 border-b border-zinc-200 px-6 py-20 transition-colors duration-300 dark:border-white/5">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 border-l-4 border-brand pl-6" data-reveal>
        <h2 class={sectionHeading}>{coach.gallery.heading}</h2>
      </div>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-3" data-reveal-children>
        {coach.gallery.items.map((g) => (
          <div class="group relative aspect-[4/5] overflow-hidden bg-zinc-100 dark:bg-zinc-900">
            <ColorHoverImage src={g.src} alt={g.alt} widths={[300, 600]} sizes="(min-width: 768px) 33vw, 50vw" />
            <span class="absolute bottom-3 left-3 bg-brand px-2 py-0.5 font-mono text-[10px] uppercase tracking-widest text-white">{g.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-10 overflow-hidden px-6 py-24 transition-colors duration-300">
    <div class="absolute inset-0 bg-brand opacity-10 mix-blend-multiply dark:opacity-20"></div>
    <div class="relative mx-auto max-w-3xl text-center">
      <h2 class="mb-6 text-3xl font-semibold uppercase tracking-tight text-zinc-900 md:text-5xl dark:text-white">{coach.cta.heading}</h2>
      <p class="mb-8 text-lg font-light text-zinc-600 dark:text-zinc-300">{coach.cta.text}</p>
      <a href={`${HOME}#pricing`} class="inline-block bg-zinc-900 px-12 py-5 text-lg font-bold uppercase tracking-widest text-white transition-all duration-300 hover:scale-105 hover:bg-brand hover:text-white dark:bg-white dark:text-black dark:hover:bg-brand dark:hover:text-white">{coach.cta.buttonLabel}</a>
    </div>
  </section>

  <Footer variant="page" />
</Base>
