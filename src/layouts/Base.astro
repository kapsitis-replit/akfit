---
/**
 * Page shell for every public page: <head> (SEO, social preview, favicon),
 * pre-paint theme detection, global styles and site script.
 */
import '@/styles/global.css';
import { SITE_URL, DEFAULT_OG_IMAGE } from '@/data/site';

interface Props {
  /** Full <title>, e.g. "Online Coaching | AK Fitness". */
  title: string;
  description: string;
  /** Path of this page for canonical/og:url, e.g. "/online-coaching.html". */
  path: string;
  /** Social-preview title/description when they differ from the page's. */
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  /** Adds <meta name="robots" content="noindex">. */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogTitle = title,
  ogDescription = description,
  ogImage = DEFAULT_OG_IMAGE,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%2309090b'/%3E%3Ctext x='50' y='70' font-family='Arial,sans-serif' font-size='54' font-weight='700' text-anchor='middle' fill='%23d70c32'%3EAK%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang="lv" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#d70c32" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="lv_LV" />
    <meta property="og:site_name" content="AK Fitness" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={favicon} />

    <!-- Apply the saved theme before first paint (avoids a flash of the wrong theme). -->
    <script is:inline>
      try {
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class="bg-zinc-50 dark:bg-zinc-950 text-zinc-600 dark:text-zinc-300 antialiased selection:bg-brand selection:text-white transition-colors duration-300">
    <slot />
    <script>
      import '@/scripts/site.ts';
    </script>
  </body>
</html>
