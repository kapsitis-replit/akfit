---
import { Icon } from 'astro-icon/components';
import type { Service } from '@/data/types';

interface Props {
  focus: NonNullable<Service['focus']>;
}
const { focus } = Astro.props;
---
<section class="relative z-10 border-b border-zinc-200 bg-zinc-100 px-6 py-20 transition-colors duration-300 dark:border-white/5 dark:bg-zinc-900">
  <div class="mx-auto max-w-4xl text-center">
    <Icon name={focus.icon} width={48} height={48} class="mx-auto mb-6 text-brand" aria-hidden="true" />
    <h2 class="mb-6 text-3xl font-semibold uppercase tracking-tight text-zinc-900 md:text-5xl dark:text-white">{focus.heading}</h2>
    <p class="text-lg leading-relaxed font-light text-zinc-600 dark:text-zinc-300" set:html={focus.body} />
    {focus.cards.length > 0 && (
      <div class="mt-12 grid grid-cols-1 gap-4 text-left sm:grid-cols-3">
        {focus.cards.map((card) => (
          <div class="border border-zinc-200 bg-white p-6 dark:border-white/5 dark:bg-zinc-950/50">
            <p class="mb-1 text-2xl font-semibold text-brand">{card.title}</p>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">{card.text}</p>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
