---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import BackLink from '@/components/sections/BackLink.astro';
import { HOME } from '@/data/site';
import type { Service } from '@/data/types';

interface Props {
  hero: Service['hero'];
}
const { hero } = Astro.props;
---
<header class="relative z-10 overflow-hidden border-b border-zinc-200 px-6 pt-32 pb-20 transition-colors duration-300 md:pt-48 md:pb-28 dark:border-white/5">
  <div class="absolute inset-0 z-[-1] overflow-hidden">
    <Image
      src={hero.image}
      alt=""
      inferSize
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="animate-slow-pan h-full w-full object-cover opacity-40 transition-opacity duration-500 dark:opacity-100"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-50 via-transparent dark:via-zinc-950/90 to-zinc-50/80 dark:from-zinc-950 dark:to-zinc-950/80"></div>
  </div>
  <div class="mx-auto max-w-7xl">
    <BackLink href={`${HOME}#pricing`} label="Visi Pakalpojumi" />
    <div class="grid grid-cols-1 items-end gap-12 lg:grid-cols-12">
      <div class="space-y-6 lg:col-span-8">
        <span class="inline-block border border-brand/40 px-3 py-1 font-mono text-xs uppercase tracking-widest text-brand">{hero.badge}</span>
        <h1 class="animate-intro text-4xl leading-tight font-semibold uppercase tracking-tight text-zinc-900 md:text-6xl dark:text-white md:leading-none">
          {hero.title}
          <span class="bg-gradient-to-r from-brand to-[#ef4464] bg-clip-text text-transparent">{hero.titleAccent}</span>
        </h1>
        <p class="max-w-xl border-l-2 border-brand pl-6 text-lg leading-relaxed font-normal text-zinc-800 md:text-xl dark:font-light dark:text-zinc-400 md:leading-[1.75rem]" set:html={hero.lede} />
        <div class="flex items-baseline gap-2 pt-2">
          {hero.price.prefix && <span class="font-mono text-xs uppercase tracking-widest text-zinc-500">{hero.price.prefix}</span>}
          <span class="text-4xl font-semibold tracking-tight text-zinc-900 dark:text-white">{hero.price.amount}</span>
          <span class="font-mono text-xs uppercase tracking-widest text-zinc-500">{hero.price.unit}</span>
        </div>
        <div class="flex flex-col gap-4 pt-4 sm:flex-row">
          <a href={hero.primaryCta.href} class="group relative bg-[#d70c32] px-8 py-4 text-center font-semibold uppercase tracking-widest text-white transition-all hover:bg-brand-dark">
            <span class="absolute inset-0 translate-x-1 translate-y-1 border border-white/20 transition-transform group-hover:translate-x-0 group-hover:translate-y-0"></span>
            <span class="relative">{hero.primaryCta.label}</span>
          </a>
          <a href={hero.secondaryCta.href} class="border border-zinc-300 px-8 py-4 text-center font-medium uppercase tracking-widest text-zinc-700 transition-colors hover:border-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-white">
            {hero.secondaryCta.label}
          </a>
        </div>
      </div>
      <div class="hidden lg:col-span-4 lg:block">
        <div class="skew-y-[-2deg] border border-zinc-200 bg-white/50 p-6 backdrop-blur-xs dark:border-white/5 dark:bg-zinc-950/50">
          <p class="mb-4 font-mono text-xs uppercase tracking-widest text-brand">{hero.summaryTitle}</p>
          <ul class="space-y-3 text-sm">
            {hero.summary.map((item) => (
              <li class="flex items-start gap-3 text-zinc-900 dark:text-white">
                <Icon name="solar:check-circle-bold" width={16} height={16} class="mt-0.5 min-w-[16px] text-brand" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>
