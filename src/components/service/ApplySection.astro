---
import ContactForm from '@/components/ContactForm.astro';
import { HOME } from '@/data/site';
import type { Service } from '@/data/types';

interface Props {
  apply: Service['apply'];
}
const { apply } = Astro.props;
---
<section id="pieteikties" class="relative z-10 px-6 py-20 transition-colors duration-300">
  <div class="mx-auto max-w-3xl">
    <div class="relative overflow-hidden border border-zinc-200 bg-white p-8 shadow-xl shadow-black/5 md:p-10 dark:border-white/5 dark:bg-zinc-950 dark:shadow-none">
      <div class="absolute top-0 left-0 h-1 w-full bg-brand"></div>
      <div class="mb-8 text-center">
        <span class="font-mono text-xs uppercase tracking-widest text-brand">{apply.eyebrow}</span>
        <h3 class="mt-2 text-3xl font-semibold uppercase tracking-tight text-zinc-900 dark:text-white">{apply.heading}</h3>
        <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">{apply.text}</p>
      </div>
      <ContactForm
        packageName={apply.packageName}
        messagePlaceholder={apply.messagePlaceholder}
        buttonLabel={apply.buttonLabel}
      />
    </div>
    <p class="mt-8 text-center">
      <a href={`${HOME}#pricing`} class="font-mono text-xs uppercase tracking-widest text-zinc-500 transition-colors hover:text-brand">{apply.backLabel}</a>
    </p>
  </div>
</section>
