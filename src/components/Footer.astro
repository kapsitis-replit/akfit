---
/**
 * Site footer, in the two layouts the legacy site used:
 * - `home`: landing page (credentials strip, legal links, social icons)
 * - `page`: service/coach pages (service and coach link lists)
 */
import { Icon } from 'astro-icon/components';
import { HOME, SERVICE_LINKS, COACH_LINKS, LEGAL_LINKS, SOCIAL_LINKS } from '@/data/site';

interface Props {
  variant?: 'home' | 'page';
}

const { variant = 'page' } = Astro.props;
const year = new Date().getFullYear();
const socials = SOCIAL_LINKS.filter((s) => s.href);

const heading = 'mb-4 text-xs font-bold uppercase tracking-wider text-zinc-900 transition-colors dark:text-white';
const list = 'space-y-2 font-mono text-xs text-zinc-500';
const link = 'transition-colors hover:text-brand';
---
<footer class="relative z-10 border-t border-zinc-200 bg-zinc-50 px-6 py-12 transition-colors duration-300 dark:border-zinc-900 dark:bg-black">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 md:grid-cols-4">
    <div class="col-span-1 md:col-span-2">
      <a href={variant === 'home' ? '#' : HOME} class="mb-4 block text-2xl font-bold uppercase tracking-tighter text-zinc-900 transition-colors dark:text-white">
        AK <span class="text-brand">FITNESS</span>
      </a>
      <p class="max-w-xs text-sm text-zinc-500">
        Veidojam spēcīgākus cilvēkus caur zinātni, darbu un disciplīnu. Rīga, Latvija.
      </p>

      {variant === 'home' && (
        <div class="mt-6 border border-zinc-200 bg-white p-4 transition-colors dark:border-zinc-900 dark:bg-zinc-950/40">
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
            <div class="flex items-center gap-2">
              <Icon name="solar:verified-check-linear" width={16} height={16} class="text-brand" aria-hidden="true" />
              <span class="text-xs font-semibold uppercase tracking-widest text-zinc-900 transition-colors dark:text-white">10+ Gadu Pieredze</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="solar:shield-warning-linear" width={16} height={16} class="text-brand" aria-hidden="true" />
              <span class="text-xs font-semibold uppercase tracking-widest text-zinc-600 transition-colors dark:text-zinc-300">REPS Level 3 sertificēti</span>
            </div>
          </div>
          <p class="mt-3 font-mono text-xs uppercase tracking-widest text-zinc-500">Pierādījumi. Pūles. Izpilde.</p>
        </div>
      )}
    </div>

    {variant === 'home' ? (
      <>
        <div>
          <h4 class={heading}>Juridiskā Info</h4>
          <ul class={list}>
            <li><a href={LEGAL_LINKS.privacy} class={link}>Privātuma Politika</a></li>
            <li><a href={LEGAL_LINKS.terms} class={link}>Noteikumi</a></li>
            <li><a href={LEGAL_LINKS.withdrawal} class={link}>Atteikuma Tiesības</a></li>
          </ul>
        </div>
        <div>
          {socials.length > 0 && (
            <>
              <h4 class={heading}>Seko Mums</h4>
              <div class="flex gap-4">
                {socials.map((s) => (
                  <a href={s.href} aria-label={s.label} rel="noopener" class="text-zinc-400 transition-colors hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white">
                    <Icon name={s.icon} width={20} height={20} aria-hidden="true" />
                  </a>
                ))}
              </div>
            </>
          )}
        </div>
      </>
    ) : (
      <>
        <div>
          <h4 class={heading}>Pakalpojumi</h4>
          <ul class={list}>
            {SERVICE_LINKS.map((s) => <li><a href={s.href} class={link}>{s.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h4 class={heading}>Treneri</h4>
          <ul class={list}>
            {COACH_LINKS.map((c) => <li><a href={c.href} class={link}>{c.label}</a></li>)}
          </ul>
        </div>
      </>
    )}
  </div>

  <div class="mx-auto mt-12 max-w-7xl border-t border-zinc-200 pt-8 text-center transition-colors md:text-left dark:border-zinc-900">
    <p class="text-xs uppercase tracking-widest text-zinc-500 dark:text-zinc-700">
      © {year} AK Fitness. Visas tiesības aizsargātas.<br />
      <a href={LEGAL_LINKS.privacy} class="underline transition-colors hover:text-zinc-900 dark:hover:text-white">Privātuma politika</a> &middot;
      <a href={LEGAL_LINKS.terms} class="underline transition-colors hover:text-zinc-900 dark:hover:text-white">Pakalpojuma noteikumi</a>
    </p>
  </div>
</footer>
