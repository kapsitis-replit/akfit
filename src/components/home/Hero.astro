---
/** Landing page: 1. Hero Section (ported from indexreal.html). */
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import TestimonialCarousel from './TestimonialCarousel.astro';
import NumberTicker from '@/components/NumberTicker.astro';
---
<header class="z-10 md:pt-48 md:pb-32 overflow-hidden dark:border-white/5 transition-colors duration-300 border-zinc-200 border-b pt-32 pr-6 pb-20 pl-6 relative">
  <!-- Background Image with Filter -->
  <div class="absolute inset-0 z-[-1] overflow-hidden">
    <Image
      src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1600&auto=format&fit=crop&sat=-100"
      alt=""
      inferSize
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="animate-slow-pan dark:opacity-100 transition-opacity duration-500 opacity-40 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-50 dark:from-zinc-950 via-transparent dark:via-zinc-950/90 to-zinc-50/80 dark:to-zinc-950/80 transition-colors duration-300"></div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 max-w-7xl mr-auto ml-auto gap-x-12 gap-y-12 items-end">
    <div class="lg:col-span-8 space-y-8">
      <!-- Social Proof Strip -->
      <div class="flex items-center gap-2 text-[#d70c32]">
        <Icon name="solar:star-linear" width={16} height={16} aria-hidden="true" />
        <Icon name="solar:star-linear" width={16} height={16} aria-hidden="true" />
        <Icon name="solar:star-linear" width={16} height={16} aria-hidden="true" />
        <Icon name="solar:star-linear" width={16} height={16} aria-hidden="true" />
        <Icon name="solar:star-linear" width={16} height={16} aria-hidden="true" />
        <span class="text-zinc-500 dark:text-zinc-400 text-xs font-mono uppercase tracking-widest ml-2">
          <NumberTicker value={1000} suffix="+" /> Pārveidoti Ķermeņi
        </span>
      </div>

      <!-- Headline -->
      <h1 class="uppercase leading-tight dark:text-white transition-colors duration-300 md:text-6xl lg:text-6xl text-4xl font-semibold text-zinc-900 tracking-tight z-20 pt-0 pb-0 relative top-0 animate-intro md:leading-none lg:leading-none">
        Veido
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#d70c32] to-[#ef4464]">
          Raksturu
        </span>
        <br>
        Pārkāp
        <span class="line-through decoration-[#d70c32] decoration-4 text-zinc-400 dark:text-zinc-500">
          Robežas
        </span>
        <br>
        Ēd un trenējies
      </h1>

      <!-- Subheadline -->
      <p class="dark:text-zinc-400 leading-relaxed transition-colors duration-300 md:text-xl text-lg font-normal dark:font-light text-zinc-800 max-w-md border-[#d70c32] border-l-2 pl-6 md:leading-[1.75rem]">
        Nekādu īsāko ceļu. Nekādu atrunu. Zinātnē balstīta treniņu un uztura
        metodika
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <a href="#pricing" class="group relative px-8 py-4 bg-[#d70c32] hover:bg-[#b30a2a] text-white font-semibold uppercase tracking-widest transition-all">
          <span class="group-hover:translate-x-0 group-hover:translate-y-0 transition-transform border-white/20 border absolute top-0 right-0 bottom-0 left-0 translate-x-1 translate-y-1"></span>
          <span class="cta-shimmer" aria-hidden="true"></span>
          <span class="text-center relative">Izvēlēties Plānu</span>
        </a>
        <a href="#about" class="px-8 py-4 border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-medium uppercase tracking-widest hover:border-zinc-900 dark:hover:border-white hover:text-zinc-900 dark:hover:text-white transition-colors text-center">
          Treneri
        </a>
      </div>

      <!-- Capacity Signal -->
      <div class="max-w-2xl mt-6 border border-zinc-200 dark:border-white/5 bg-white/50 dark:bg-zinc-950/50 px-6 py-4 backdrop-blur-xs transition-colors duration-300">
        <div class="flex items-start gap-3">
          <Icon name="solar:users-group-two-rounded-linear" width={20} height={20} class="text-[#d70c32] mt-0.5" aria-hidden="true" />
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            <span class="text-zinc-900 dark:text-white font-medium">
              Ierobežots vietu skaits
            </span>
            — Mēs strādājam ar ierobežotu klientu skaitu, lai nodrošinātu
            maksimālu kvalitāti un uzmanību.
          </p>
        </div>
      </div>
    </div>

    <!-- Hero Visual Overlay Cards -->
    <TestimonialCarousel />
  </div>
</header>
