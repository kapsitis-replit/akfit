---
import { Image } from 'astro:assets';
import ColorHoverImage from '@/components/ColorHoverImage.astro';
/** Landing page: 7. Coaches Profile Section (ported from indexreal.html). */
import { Icon } from 'astro-icon/components';
---
<section class="z-10 dark:border-white/5 dark:bg-zinc-900/30 transition-colors duration-300 bg-white border-zinc-200 border-b pt-20 pr-6 pb-20 pl-6 relative" id="about">
  <div class="max-w-7xl mr-auto ml-auto">
    <div class="border-[#d70c32] border-l-4 mb-12 pl-6" data-reveal>
      <h2 class="text-4xl md:text-5xl font-semibold uppercase tracking-tight text-zinc-900 dark:text-white transition-colors">
        Treneri
      </h2>
      <p class="text-zinc-500 mt-2 font-mono uppercase tracking-widest text-xs">
        AK Fitness Komanda
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 gap-x-8 gap-y-8" data-reveal-children>
      <!-- Coach Anna -->
      <a href="treneris-anna.html" class="group flex flex-col overflow-hidden border border-zinc-200 dark:border-white/5 bg-zinc-50 dark:bg-zinc-900 hover:border-[#d70c32]/50 transition-colors duration-500">
        <div class="aspect-[4/3] overflow-hidden bg-zinc-100 dark:bg-black relative">
          <ColorHoverImage src="https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/1fd13add-fd78-4ccc-a2db-bbbc38815fd4_1600w.jpg?w=800&q=80" alt="Anna" widths={[400, 640, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="object-top" />
          <div class="absolute bottom-0 left-0 w-full h-24 bg-gradient-to-t from-zinc-50 dark:from-zinc-900 to-transparent"></div>
        </div>
        <div class="flex-1 flex flex-col p-8">
          <div class="flex items-start justify-between mb-4">
            <div>
              <h3 class="text-2xl font-semibold text-zinc-900 dark:text-white uppercase tracking-tight">Anna</h3>
              <p class="uppercase text-xs text-[#d70c32] tracking-widest font-mono mt-1">Galvenā Treneris &amp; Uztura Speciālists</p>
            </div>
            <Icon name="solar:dumbbell-large-linear" width={32} height={32} class="text-zinc-400 dark:text-zinc-600 group-hover:text-[#d70c32] transition-colors" aria-hidden="true" />
          </div>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mb-6 flex-1">Es ticu ilgtermiņa pārmaiņām, nevis īstermiņa risinājumiem. Mana pieeja apvieno spēka treniņus ar sabalansētu uzturu, lai veidotu ne tikai estētisku ķermeni, bet arī veselīgu vielmaiņu un spēcīgu garu.</p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 border border-zinc-200 dark:border-zinc-800 text-[10px] uppercase font-bold text-zinc-500">LEVEL 3 Personal Trainer</span>
            <span class="px-3 py-1 border border-zinc-200 dark:border-zinc-800 text-[10px] uppercase font-bold text-zinc-500">LEVEL 2 Gym Instructor</span>
            <span class="px-3 py-1 border border-zinc-200 dark:border-zinc-800 text-[10px] uppercase font-bold text-zinc-500">MNU Certified Nutritionist</span>
            <span class="px-3 py-1 border border-zinc-200 dark:border-zinc-800 text-[10px] uppercase font-bold text-zinc-500">MSc Drug Discovery and Development</span>
            <span class="px-3 py-1 border border-zinc-200 dark:border-zinc-800 text-[10px] uppercase font-bold text-zinc-500">BSc Pharmacology and Physiology</span>
          </div>
          <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-[#d70c32] mt-auto">Skatīt pilnu profilu <Icon name="solar:arrow-right-linear" width={14} height={14} class="arrow-nudge" aria-hidden="true" /></span>
        </div>
      </a>

      <!-- Coach Kristaps -->
      <a href="treneris-krisjanis.html" class="group flex flex-col overflow-hidden border border-zinc-200 dark:border-white/5 bg-zinc-50 dark:bg-zinc-900 hover:border-[#d70c32]/50 transition-colors duration-500">
        <div class="aspect-[4/3] overflow-hidden bg-zinc-100 dark:bg-black relative">
          <ColorHoverImage src="https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/661f3020-b60d-4f71-aec2-aaa8b2c5b9e6_1600w.png?w=800&q=80" alt="Krišjānis" widths={[400, 640, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="object-top" />
          <div class="absolute bottom-0 left-0 w-full h-24 bg-gradient-to-t from-zinc-50 dark:from-zinc-900 to-transparent"></div>
        </div>
        <div class="flex-1 flex flex-col p-8">
          <div class="flex items-start justify-between mb-4">
            <div>
              <h3 class="text-2xl font-semibold text-zinc-900 dark:text-white uppercase tracking-tight">Krišjānis</h3>
              <p class="uppercase text-xs text-[#d70c32] tracking-widest font-mono mt-1">Spēka &amp; Kondīcijas Treneris</p>
            </div>
            <Icon name="solar:stopwatch-linear" width={32} height={32} class="text-zinc-400 dark:text-zinc-600 group-hover:text-[#d70c32] transition-colors" aria-hidden="true" />
          </div>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mb-6 flex-1">Mani treniņi ir balstīti uz disciplīnu un tehniku. Es palīdzēšu tev sasniegt fizisko potenciālu caur pārdomātu slodzi. Ja tu esi gatavs strādāt, es esmu gatavs tevi aizvest līdz mērķim.</p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 border border-zinc-200 dark:border-zinc-800 text-[10px] uppercase font-bold text-zinc-500">LEVEL 3 Personal Trainer</span>
            <span class="px-3 py-1 border border-zinc-200 dark:border-zinc-800 text-[10px] uppercase font-bold text-zinc-500">LEVEL 2 Gym Instructor</span>
            <span class="px-3 py-1 border border-zinc-200 dark:border-zinc-800 text-[10px] uppercase font-bold text-zinc-500">BSc Sports and Exercise Science (Strength and Conditioning)</span>
          </div>
          <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-[#d70c32] mt-auto">Skatīt pilnu profilu <Icon name="solar:arrow-right-linear" width={14} height={14} class="arrow-nudge" aria-hidden="true" /></span>
        </div>
      </a>
    </div>
  </div>
</section>
